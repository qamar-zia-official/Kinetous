# Copy to .env (repo root) and fill in values.
# Apps may also use gitignored .env.local files for Next.js-specific overrides.

# --- Database (shared; used by @repo/db and drizzle-kit) ---
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- better-auth ---
BETTER_AUTH_SECRET=change-me
# Public base URL of the app being served (e.g. https://kinetous.com or http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# --- AI chat widget (/api/chat) ---
GROQ_API_KEY=

# --- Transactional email (verification mails via Resend) ---
RESEND_API_KEY=

# --- Social login ---
# NOTE: the "SECRETE" spelling is intentional — the code reads these exact names.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRETE=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRETE=

# --- Cloudinary (cover images / OG images) ---
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# --- Misc tooling keys (optional) ---
JINA_API_KEY=
PAGESPEED_API_KEY=
