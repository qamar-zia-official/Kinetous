{
    "extends": "@repo/typescript-config/react-library.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "lib": ["es2022", "DOM", "DOM.Iterable"],
        "types": ["react", "react-dom"]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
