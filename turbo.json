{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",

    // The repo-root `.env` is the shared source of truth for database and
    // cross-app tooling (drizzle-kit, one-off scripts). Listing it here means
    // Turbo's cache key changes when it changes. Each app may also carry a
    // gitignored `.env.local` for Next.js-specific overrides.
    "globalDependencies": [".env"],

    // Turborepo 2 defaults to `envMode: "strict"`, which means any variable NOT
    // declared here is STRIPPED from the task's environment. Declare names
    // explicitly; only names are committed here, never values.
    //
    // Secrets go in `globalPassThroughEnv` rather than `globalEnv` on purpose:
    // `globalEnv` participates in the task hash, and we do not want secret
    // material (even hashed) influencing a cache key that may be uploaded to a
    // remote cache.
    "globalEnv": [
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET"
    ],
    "globalPassThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GROQ_API_KEY",
        "RESEND_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRETE",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRETE",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "JINA_API_KEY",
        "PAGESPEED_API_KEY"
    ],

    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["$TURBO_DEFAULT$", ".env*"],
            "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "typecheck": {
            "dependsOn": ["^typecheck"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^test"],
            "outputs": []
        },
        "db:generate": {
            "cache": false
        },
        "db:migrate": {
            "cache": false
        },
        "db:push": {
            "cache": false
        },
        "db:studio": {
            "cache": false,
            "persistent": true
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}
